#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      dvp_amp_pct: dvp_amp_pct {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N6)>, <&kp LS(N5)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_lbrack_7: dvp_lbrack_7 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N8)>, <&kp N7>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_lbrace_5: dvp_lbrace_5 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N7)>, <&kp N5>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_rbrace_3: dvp_rbrace_3 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N0)>, <&kp N3>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_lpar_1: dvp_lpar_1 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N8)>, <&kp N1>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_equal_9: dvp_equal_9 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N0)>, <&kp N9>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_star_0: dvp_star_0 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(BSLH)>, <&kp N0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_rpar_2: dvp_rpar_2 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N9)>, <&kp N2>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_plus_4: dvp_plus_4 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp MINUS>, <&kp N4>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_rbrack_6: dvp_rbrack_6 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N9)>, <&kp N6>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_excl_8: dvp_excl_8 {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N1)>, <&kp N8>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_grave: dvp_grave {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <30>;
          tap-ms = <30>;
          bindings = <&kp LS(EQUAL)>, <&kp SPACE>;
      };

      dvp_hash_grave: dvp_hash_grave {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N3)>, <&dvp_grave>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_slash_question: dvp_slash_question {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(N7)>, <&kp LS(MINUS)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_tilde: dvp_tilde {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <30>;
          tap-ms = <30>;
          bindings = <&kp RA(RBKT)>, <&kp SPACE>;
      };

      dvp_dollar_tilde: dvp_dollar_tilde {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N4)>, <&dvp_tilde>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_caret: dvp_caret {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          wait-ms = <30>;
          tap-ms = <30>;
          bindings = <&kp LS(RBKT)>, <&kp SPACE>;
      };

      dvp_at_caret: dvp_at_caret {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(N2)>, <&dvp_caret>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_semi_colon: dvp_semi_colon {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp LS(COMMA)>, <&kp LS(DOT)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_comma_less: dvp_comma_less {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp COMMA>, <&kp NON_US_BACKSLASH>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_dot_greater: dvp_dot_greater {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp DOT>, <&kp LS(NON_US_BACKSLASH)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_apostrophe_quote: dvp_apostrophe_quote {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp BSLH>, <&kp LS(N2)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_backslash_pipe: dvp_backslash_pipe {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp RA(MINUS)>, <&kp RA(NON_US_BACKSLASH)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      dvp_hyphen_underscore: dvp_hyphen_underscore {
          compatible = "zmk,behavior-mod-morph";
          #binding-cells = <0>;
          bindings = <&kp FSLH>, <&kp LS(FSLH)>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &dvp_amp_pct &dvp_lbrack_7 &dvp_lbrace_5 &dvp_rbrace_3 &dvp_lpar_1 &dvp_equal_9 &tog 1                                     &mo 3 &dvp_star_0 &dvp_rpar_2 &dvp_plus_4 &dvp_rbrack_6 &dvp_excl_8 &dvp_hash_grave
        &kp TAB   &dvp_semi_colon &dvp_comma_less &dvp_dot_greater &kp P &kp Y &none                                                &none &kp F  &kp G  &kp C     &kp R    &kp L    &dvp_backslash_pipe
        &kp HOME  &kp A     &kp O    &kp E    &kp U      &kp I  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp D  &kp H  &kp T     &kp N    &kp S    &kp PG_UP
        &kp END   &dvp_apostrophe_quote &kp Q &kp J &kp K &kp X                            &kp LGUI &kp PG_UP                           &kp B  &kp M  &kp W     &kp V    &kp Z    &kp PG_DN
        &mo 2     &dvp_at_caret &dvp_hyphen_underscore &kp LEFT &kp RIGHT    &kp BSPC &kp ESC   &kp LSHFT &kp RSHFT &kp ENTER &kp SPACE              &kp UP &kp DOWN  &dvp_slash_question &dvp_dollar_tilde &mo 2
      >;
    };
    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp P      &kp Y  &none                                                            &none &kp F  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp HOME  &kp A     &kp O    &kp E    &kp U      &kp I  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp D  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp PG_UP
        &kp END   &kp Z     &kp Q    &kp J    &kp K      &kp X                            &kp LGUI &kp PG_UP                           &kp B  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp PG_DN
        &mo 2     &kp RBKT  &kp LBKT &kp LEFT &kp RIGHT                &kp BSPC &kp ESC   &kp LSHFT &kp RSHFT &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp GRAVE       &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
